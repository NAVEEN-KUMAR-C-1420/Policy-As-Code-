# Copy this file to .env and fill in the values you need.
# You only need the API key for whichever provider is set as
# "active_provider" in config/providers.yaml.

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: used by the Data Collector Agent's search_market_news tool.
# If left blank, that tool just returns a message saying it was skipped.
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: LangSmith tracing. Set LANGCHAIN_TRACING_V2=true to see
# every LLM call and tool call from this project in your LangSmith
# dashboard. No code changes needed - LangChain reads these automatically.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=finance-multi-agent-governance